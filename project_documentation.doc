    </tr>
    <tr>
      <td><code>public.activity_logs</code></td>
      <td><code>id (uuid)</code></td>
      <td>References <code>public.profiles(id)</code></td>
      <td>Audit logs tracking administrative operations.</td>
    </tr>
    <tr>
      <td><code>public.website_settings</code></td>
      <td><code>id (uuid)</code></td>
      <td>None</td>
      <td>Key-value configurations for SEO, social handles, and general contact details.</td>
    </tr>
    <tr>
      <td><code>public.team_members</code></td>
