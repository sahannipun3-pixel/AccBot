# ─────────────────────────────────────────────────────────────────────────────
# AccBots — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# This template (.env.local.example) contains only safe placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Transaction pooler recommended for Railway)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 32 characters long
JWT_SECRET=replace-with-a-64-character-random-hex-string-generated-securely

JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ── Site URL ──────────────────────────────────────────────────────────────────
# In production, set to your Railway public domain (e.g. https://accbots.up.railway.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Resend Email ──────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The verified "from" address in Resend (must match your verified domain)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Admin email that receives contact form notifications
ADMIN_EMAIL=admin@yourdomain.com

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# Found in: Cloudflare Dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Public CDN URL for your R2 bucket (enable public access or use a custom domain)
# Example: https://pub-xxxxxxxxxx.r2.dev  OR  https://cdn.yourdomain.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Google OAuth (optional — configure when ready) ───────────────────────────
# Get credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://[YOUR_DOMAIN]/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
