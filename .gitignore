# ═════════════════════════════════════════════════════════════════════════════
# AccBots — Production .gitignore
# ═════════════════════════════════════════════════════════════════════════════
# Standards: GitHub & Next.js Production Architecture
# Rule: Security First. Never commit secrets, credentials, or generated files.
# ═════════════════════════════════════════════════════════════════════════════

# ── 1. Dependencies & Package Managers ───────────────────────────────────────
node_modules/
npm-packages-offline-cache/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Ensure lockfile is strictly tracked (pnpm project)
!pnpm-lock.yaml

# ── 2. Next.js Build & Generated Output ──────────────────────────────────────
.next/
out/
build/
dist/
.output/

# ── 3. Environment Variables & Secrets (CRITICAL) ────────────────────────────
# Ignore all variations of local environment and secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.*.local
*.env
*.env.*
*.local

# STRICT EXCEPTIONS: Example templates MUST remain tracked for onboarding & CI/CD
!.env.example
!.env.local.example

# ── 4. Private Keys, Certificates & Credentials ──────────────────────────────
*.pem
*.key
*.crt
*.cert
*.cer
*.der
*.pfx
*.p12
*.csr
id_rsa*
id_ed25519*
secrets.json
credentials.json
service-account*.json
*-credentials.json
*.keystore

# ── 5. Logs & Debug Traces ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
.turbo/

# ── 6. Testing & Coverage ────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.clinic/
reports/

# ── 7. TypeScript & Build Caches ─────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# ── 8. Cloud & PaaS Tooling Caches ───────────────────────────────────────────
.vercel/
.railway/

# ── 9. IDEs, Editors & Workspaces ────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── 10. Operating System Files ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# ── 11. Temporary Files & Local Dumps ────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.dump
*.sql.dump
*.sql.bak
tmp/
temp/

# ── 12. Local User Uploads & Media Runtime Data ──────────────────────────────
# Prevent local runtime uploads from being committed (assets in /public remain tracked)
uploads/
runtime-uploads/
receipt-cache/
